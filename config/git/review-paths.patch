diff --git a/lua/review/hooks.lua b/lua/review/hooks.lua
index f49ab58..2dc2a91 100644
--- a/lua/review/hooks.lua
+++ b/lua/review/hooks.lua
@@ -11,1 +11,11 @@ local current_tabpage = nil
 local buf_augroup = nil
+
+---@param path string|table|nil
+---@return string|nil
+local function path_value(path)
+  if type(path) == "table" then
+    return path.absolute ~= "" and path.absolute or path.relative
+  end
+  return path
+end
+
@@ -13,7 +23,8 @@ local buf_augroup = nil
 ---Set filetype for a buffer based on file path
 ---@param bufnr number
----@param path string|nil
+---@param path string|table|nil
 local function set_buffer_filetype(bufnr, path)
+  path = path_value(path)
   if not bufnr or not vim.api.nvim_buf_is_valid(bufnr) then
     return
   end
@@ -57,9 +68,10 @@ function M.get_session()
 ---Relativize a path against the git root for consistent storage/lookup
----@param path string|nil
+---@param path string|table|nil
 ---@param lifecycle table
 ---@param tabpage number
 ---@return string|nil
 local function relativize_path(path, lifecycle, tabpage)
+  path = path_value(path)
   if not path then
     return nil
   end
