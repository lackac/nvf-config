diff --git a/lua/review/export.lua b/lua/review/export.lua
index 18bfe21..de8fcad 100644
--- a/lua/review/export.lua
+++ b/lua/review/export.lua
@@ -119,1 +119,18 @@
+function M.to_opencode()
+  local ok, opencode = pcall(require, "opencode")
+  if not ok then
+    notify("opencode.nvim not installed", vim.log.levels.ERROR)
+    return
+  end
+
+  local count = store.count()
+  if count == 0 then
+    notify("No comments to send", vim.log.levels.WARN)
+    return
+  end
+
+  opencode.prompt(M.generate_markdown())
+  notify(string.format("Sent %d comment(s) to OpenCode", count), vim.log.levels.INFO)
+end
+
 return M
